module {
  func.func @transpose_demo(
      %a: tensor<30x40x20xf32>,
      %b: tensor<30x20x40xf32>) -> tensor<30x40x20xf32> {
    %ta = tosa.transpose %a {perms = array<i32: 2, 0, 1>}
        : (tensor<30x40x20xf32>) -> tensor<20x30x40xf32>
    %tb = tosa.transpose %b {perms = array<i32: 1, 0, 2>}
        : (tensor<30x20x40xf32>) -> tensor<20x30x40xf32>
    %max = tosa.maximum %ta, %tb
        : (tensor<20x30x40xf32>, tensor<20x30x40xf32>) -> tensor<20x30x40xf32>
    %exp = tosa.exp %max
        : (tensor<20x30x40xf32>) -> tensor<20x30x40xf32>
    %out = tosa.transpose %exp {perms = array<i32: 1, 2, 0>}
        : (tensor<20x30x40xf32>) -> tensor<30x40x20xf32>
    return %out : tensor<30x40x20xf32>
  }
}
